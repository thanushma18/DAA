import time
def knapsack(w,v,c):
 d=[0]*(c+1)
 for x,y in zip(w,v):
  for j in range(c,x-1,-1):d[j]=max(d[j],d[j-x]+y)
 return d[c]
def fractional(w,v,c):
 a=sorted(zip(w,v),key=lambda x:x[1]/x[0],reverse=True);s=0
 for x,y in a:
  t=min(x,c);s+=t*y/x;c-=t
  if c==0:break
 return s
def jobs(a):
 a.sort(key=lambda x:x[2],reverse=True);s=[0]*max(x[1] for x in a);p=0
 for n,d,v in a:
  for i in range(min(d,len(s))-1,-1,-1):
   if not s[i]:s[i]=n;p+=v;break
 return s,p
def color(g,m):
 n=len(g);c=[0]*n
 def solve(v):
  if v==n:return True
  for x in range(1,m+1):
   if all(not g[v][u] or c[u]!=x for u in range(n)):
    c[v]=x
    if solve(v+1):return True
    c[v]=0
  return False
 return c if solve(0) else None
def tsp(d):
 n=len(d);best=[float('inf')]
 def go(v,seen,cost):
  if len(seen)==n:best[0]=min(best[0],cost+d[v][0]);return
  for x in range(n):
   if x not in seen:go(x,seen|{x},cost+d[v][x])
 go(0,{0},0);return best[0]
def run(f,*a):
 t=time.perf_counter();r=f(*a);return r,(time.perf_counter()-t)*1000
